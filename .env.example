# Copy to .env.local and fill in. Never commit real values.
# Names from PRD section 13 (and 17.6 for testimonials, used from Phase 6B).

# All environments
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile site key. Local development: the documented test key
# 1x00000000000000000000AA (always passes).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only
# Turnstile secret. Local development: test secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# Resend API key with "sending access" only.
RESEND_API_KEY=
# Inbox that receives contact messages.
CONTACT_TO_EMAIL=
# Sender on a Resend-verified domain, e.g. "Portfolio <portfolio@your-domain>".
CONTACT_FROM_EMAIL=
# Optional, never in production: 1 = accept the Turnstile dummy token and simulate
# Resend (used by the Playwright build). Refused when VERCEL_ENV=production.
CONTACT_TEST_MODE=

# Testimonials (Phase 6B, PRD 17.6)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
CRON_SECRET=

# Content CMS — Keystatic (PRD 18.6). Local storage in development needs none of these.
# GitHub storage (production + preview): set STORAGE=github and REPO=owner/name.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Created by the Keystatic GitHub App setup flow (/keystatic in development):
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
